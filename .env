NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://*.localhost:3000

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/collegequery_dev?schema=public"
MONGODB_URI="mongodb://localhost:27017/collegequery_chat"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET="cq_super_secret_jwt_access_key_change_in_production_2026!"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="cq_super_secret_jwt_refresh_key_change_in_production_2026!"
JWT_REFRESH_EXPIRES_IN="7d"

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=collegequery-attachments
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_FORCE_PATH_STYLE=true

SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test
SMTP_PASS=test
EMAIL_FROM="CollegeQuery <no-reply@collegequery.com>"
